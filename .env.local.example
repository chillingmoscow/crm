# ============================================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА (Supabase CLI + Docker)
# Скопировать значения из: pnpm db:status
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key из pnpm db:status>

# ============================================================
# PRODUCTION (self-hosted Supabase на сервере)
# Coolify: добавить эти переменные в Environment Variables проекта
# Значения: Supabase Studio → Settings → API
# ============================================================
# NEXT_PUBLIC_SITE_URL=https://sheerly.app
# NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-domain.com
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=465
# SMTP_USER=your-yandex-postbox-api-key-id
# SMTP_PASS=your-yandex-postbox-api-key-secret
# SMTP_ADMIN_EMAIL=noreply@sheerly.app
# SMTP_SENDER_NAME=Sheerly
