# ============================================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА (Supabase CLI + Docker)
# Скопировать значения из: pnpm db:status
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key из pnpm db:status>
SUPABASE_SERVICE_ROLE_KEY=<service_role key из pnpm db:status>

# 32 байта в base64. Можно сгенерировать: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# ============================================================
# PRODUCTION (self-hosted Supabase на сервере)
# Coolify: добавить эти переменные в Environment Variables проекта
# Значения: Supabase Studio → Settings → API
# ============================================================
# NEXT_PUBLIC_SITE_URL=https://sheerly.app
# NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-domain.com
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=465
# SMTP_USER=your-yandex-postbox-api-key-id
# SMTP_PASS=your-yandex-postbox-api-key-secret
# SMTP_ADMIN_EMAIL=noreply@sheerly.app
# SMTP_SENDER_NAME=Sheerly

# ============================================================
# DaData (юрлица и адреса по ИНН)
# https://dadata.ru/api/
# Запросы выполняются ТОЛЬКО на сервере (server actions / API routes).
# Никогда не использовать с клиента.
# ============================================================
DADATA_API_KEY=
DADATA_SECRET_KEY=

# ============================================================
# DeepSeek AI (chat / editor commands)
# https://platform.deepseek.com/api_keys
# Используется в src/lib/ai/deepseek-client.ts через `openai` SDK
# с baseURL https://api.deepseek.com/v1. Применяется в KB slash-
# командах (/ai-shorten, /ai-rephrase, etc) — см. миграцию 071.
# Запросы только на сервере (server actions); клиент не получает key.
# ============================================================
DEEPSEEK_API_KEY=

# ============================================================
# SiliconFlow AI (embeddings для RAG)
# https://cloud.siliconflow.cn — API keys в Account Settings
# Используется в src/lib/ai/siliconflow-client.ts через `openai` SDK
# с baseURL https://api.siliconflow.cn/v1. Применяется в RAG-pipeline
# (src/lib/knowledge/embeddings.ts + ai-rag.ts) — модель BAAI/bge-m3
# (1024 dim, multilingual). См. миграцию 072.
# Запросы только на сервере; клиент не получает key.
# ============================================================
SILICONFLOW_API_KEY=

# ============================================================
# Support / bug-report tool («Помощь и поддержка» в меню профиля)
# Server action src/lib/support/actions.ts создаёт GitHub-issue +
# дублирует письмом разработчику. GITHUB_TOKEN — fine-grained PAT
# с правами Issues: read/write ТОЛЬКО на chillingmoscow/crm.
# Все ключи серверные, клиенту не отдаются. Если GITHUB_* не заданы —
# репорт уходит только письмом (best-effort GitHub отключается).
# SUPPORT_ATTACHMENT_TTL — срок жизни подписанной ссылки на вложение
# (секунды; по умолчанию 2592000 = 30 дней).
# ============================================================
GITHUB_TOKEN=
GITHUB_REPO=chillingmoscow/crm
SUPPORT_INBOX_EMAIL=chillingmoscow@gmail.com
SUPPORT_ATTACHMENT_TTL=2592000
